COMPOSE_PROJECT_NAME=bank-eval

BANK_EVAL_KAFKA_BROKER=127.0.0.1:19094
BANK_EVAL_COMMAND_TOPIC=statevec.bank.eval.commands
BANK_EVAL_PUBLICATION_TOPIC=statevec.bank.eval.publication
BANK_EVAL_GROUP_ID=bank-eval

BANK_EVAL_DATA_DIR=run/bank-eval
BANK_EVAL_OPERATION_BIND=127.0.0.1:19181
BANK_EVAL_STATE_MEMORY_LIMIT_MB=512

# Download runtime binaries from https://github.com/jumpex-io/statevec-runtime
# and set these paths to the extracted executable files.
# GNU/Linux runtime binaries and plugin .so files require glibc >= 2.30.
BANK_EVAL_STATEVEC_EVAL_BIN=/absolute/path/to/statevec-eval
BANK_EVAL_STATEVEC_REPLAY_BIN=/absolute/path/to/statevec-replay
BANK_EVAL_STATEVEC_CLI_BIN=/absolute/path/to/statevec-cli

# The bank plugin is built from this repository by default.
# Override this path if you want to load a prebuilt plugin dylib/so.
BANK_EVAL_BANK_PLUGIN_DYLIB=
